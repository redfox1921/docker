# Kopieren nach ".env" und Passwörter ersetzen (z. B. mit: openssl rand -base64 24)
# Keine Sonderzeichen wie $ oder # in Passwörtern verwenden.
DB_NAME=teamspeak
DB_USER=teamspeak
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# Optional: Versionen festlegen
MARIADB_TAG=11.4
TS_IMAGE_TAG=latest

